<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.andychiu.automation.reminders-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>{{SCRIPTS_DIR}}/run_reminders_sync.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{{SCRIPTS_DIR}}</string>

    <!-- Hourly; launchd runs a missed interval once on wake. -->
    <key>StartInterval</key>
    <integer>3600</integer>

    <key>StandardOutPath</key>
    <string>{{HOME}}/.reminders_sync.log</string>

    <key>StandardErrorPath</key>
    <string>{{HOME}}/.reminders_sync.log</string>

    <key>RunAtLoad</key>
    <true/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>{{PATH}}</string>
        <key>HOME</key>
        <string>{{HOME}}</string>
    </dict>
</dict>
</plist>
